{
  "redirects": [
    {
      "source": "/crm",
      "destination": "/crm/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/crm/",
      "destination": "https://industrial-directory-tracker.vercel.app/index.html"
    },
    {
      "source": "/crm/:path*",
      "destination": "https://industrial-directory-tracker.vercel.app/:path*"
    }
  ]
}
